---
/**
 * Example screen: the 11:40pm call as a native-looking call screen with a live transcript and a
 * working English / Spanish switch. Labeled "Example". Lines marked `seq` play in one by one the
 * first time it is seen; without JavaScript or with reduced motion they are simply all there.
 */
---

<div class="screen screen--call" data-ui data-caller-phone>
  <span class="tag tag--dark">Example</span>
  <div class="call__head">
    <p class="call__who">New caller</p>
    <p class="call__meta">Your firm's line &middot; <span data-call-timer>0:42</span></p>
  </div>
  <div class="lang" role="group" aria-label="Greeting language">
    <button type="button" data-lang="en" aria-pressed="true">English</button>
    <button type="button" data-lang="es" aria-pressed="false">Español</button>
  </div>
  <div class="call__transcript">
    <p class="call__speaker seq">Your firm</p>
    <p class="call__line seq" data-greet="en">Thank you for calling the law firm. I can take down what happened and get it to the attorney tonight. Who am I speaking with?</p>
    <p class="call__line seq" data-greet="es" lang="es">Gracias por llamar al bufete. Puedo tomar los datos de lo que pasó y hacérselos llegar al abogado esta noche. ¿Con quién hablo?</p>
    <p class="call__speaker call__speaker--caller seq">Caller</p>
    <p class="call__line call__line--caller seq" data-greet="en">My brother was arrested tonight. They said DUI. He's at the county jail.</p>
    <p class="call__line call__line--caller seq" data-greet="es" lang="es">Arrestaron a mi hermano esta noche. Dijeron que por DUI. Está en la cárcel del condado.</p>
    <p class="call__note seq">The call continues: name, callback number, charge, county, custody status, how they found you.</p>
    <p class="typing" aria-hidden="true"><i></i><i></i><i></i></p>
  </div>
  <div class="call__controls" aria-hidden="true">
    <span><svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11h-2Z" /></svg></span>
    <span><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2" /><circle cx="12" cy="6" r="2" /><circle cx="18" cy="6" r="2" /><circle cx="6" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="18" cy="12" r="2" /><circle cx="6" cy="18" r="2" /><circle cx="12" cy="18" r="2" /><circle cx="18" cy="18" r="2" /></svg></span>
    <span><svg viewBox="0 0 24 24"><path d="M4 9v6h4l5 5V4L8 9H4Zm12.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4Z" /></svg></span>
    <span class="call__end"><svg viewBox="0 0 24 24"><path d="M12 9c-1.6 0-3.1.3-4.6.8v3.1c0 .4-.2.7-.6.9-1 .5-1.9 1.1-2.7 1.8-.2.2-.4.3-.7.3-.3 0-.5-.1-.7-.3L.3 13.3a1 1 0 0 1 0-1.4C3.3 9.1 7.5 7.4 12 7.4s8.7 1.7 11.7 4.5a1 1 0 0 1 0 1.4l-2.4 2.3c-.2.2-.4.3-.7.3-.3 0-.5-.1-.7-.3-.8-.7-1.7-1.3-2.7-1.8-.4-.2-.6-.5-.6-.9V9.8C15.1 9.3 13.6 9 12 9Z" /></svg></span>
  </div>
</div>
