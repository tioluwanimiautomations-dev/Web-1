---
/**
 * A plain, unbranded smartphone: dark bezel, island, status bar. Wraps one example screen.
 */
interface Props {
  time: string;
  /** Which app fills the screen; sets the status bar colours to match it. */
  theme: 'call' | 'slack' | 'mail' | 'sms';
}

const { time, theme } = Astro.props;
---

<div class="device" data-ui>
  <div class:list={['device__screen', 'device__screen--' + theme]}>
    <div class="device__status" aria-hidden="true">
      <span>{time}</span>
      <i class="device__island"></i>
      <span class="device__icons">
        <svg viewBox="0 0 18 12" width="17" height="11"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
        <svg viewBox="0 0 16 12" width="15" height="11"><path d="M8 2.2c2.4 0 4.6.9 6.3 2.5l1.2-1.3A10.7 10.7 0 0 0 8 .4 10.7 10.7 0 0 0 .5 3.4l1.2 1.3A9 9 0 0 1 8 2.2Zm0 3.6c1.4 0 2.7.5 3.7 1.4l1.2-1.3A7.2 7.2 0 0 0 8 4a7.2 7.2 0 0 0-4.9 1.9l1.2 1.3c1-.9 2.3-1.4 3.7-1.4Zm0 3.5c-.5 0-1 .2-1.3.5L8 11.3l1.3-1.5c-.3-.3-.8-.5-1.3-.5Z" /></svg>
        <svg viewBox="0 0 27 12" width="25" height="11"><rect x=".5" y=".5" width="22" height="11" rx="3" fill="none" stroke="currentColor" opacity=".45" /><rect x="2.5" y="2.5" width="16" height="7" rx="1.5" /><rect x="24" y="4" width="2" height="4" rx="1" opacity=".45" /></svg>
      </span>
    </div>
    <slot />
  </div>
</div>
