---
/**
 * Example screen: the approval request as a native-looking text message thread, with working
 * Approve / Decline replies. Labeled "Example".
 */
import { exampleIntake } from '../config/example';
---

<div class="screen screen--sms" data-ui data-attorney-phone>
  <div class="sms__head">
    <span class="sms__avatar" aria-hidden="true">P</span>
    <strong>PracticeOp Intake</strong>
    <small>Text Message &middot; Today 11:44 PM</small>
  </div>
  <div class="sms__thread">
    <span class="tag">Example</span>
    <div class="sms__in notify">
      <strong>New intake for your approval</strong><br />
      Caller: {exampleIntake.caller}
      {exampleIntake.fields.map(([k, v]) => <><br />{k}: {v}</>)}
    </div>
    <div class="choices sms__replies" role="group" aria-label="Example decision">
      <button type="button" class="approve" data-choice="approve" aria-pressed="false">Approve</button>
      <button type="button" class="decline" data-choice="decline" aria-pressed="false">Decline</button>
    </div>
    <div class="outcome sms__outcome" data-outcome="approve" aria-live="polite">
      <p class="sms__out">Approve</p>
      <p class="sms__in">{exampleIntake.approved}</p>
    </div>
    <div class="outcome sms__outcome" data-outcome="decline" aria-live="polite">
      <p class="sms__out">Decline</p>
      <p class="sms__in">{exampleIntake.declined}</p>
    </div>
  </div>
</div>
