---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="nf wrap" aria-labelledby="nf-title">
    <h1 id="nf-title">This page doesn't exist.</h1>
    <p class="lead" style="margin-top:20px">It may have moved. The home page and the booking link still work.</p>
    <a class="btn" href={url('/')}>Back to the home page</a>
    <p style="margin-top:20px"><a href={url(siteConfig.cta.href)}>{siteConfig.cta.label}</a></p>
  </section>
</BaseLayout>
